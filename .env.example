# Database: sqlserver | azure | sqlite
DB_BACKEND=sqlite
SQLITE_PATH=data/processed/sca.db

# SQL Server (local Docker) / Azure SQL
DB_HOST=localhost
DB_PORT=1433
DB_NAME=supplypulse
DB_USER=sa
DB_PASSWORD=
MSSQL_SA_PASSWORD=
ODBC_DRIVER=ODBC Driver 18 for SQL Server
# yes for local Docker (self-signed cert); no for Azure SQL
TRUST_SERVER_CERTIFICATE=yes
# Optional: full SQLAlchemy URL, overrides everything above
DATABASE_URL=

# LLM (Phase 7). Model names are read from here, never hardcoded.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
