# data (raw/processed are never committed; sample is)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
dashboard/data/*
!dashboard/data/.gitkeep

# secrets
.env
*.pem
kaggle.json

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# local databases
*.db
*.sqlite

# misc
.remember/
.DS_Store
*.zip
