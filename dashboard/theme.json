{
  "name": "SupplyPulse",
  "dataColors": [
    "#0072B2",
    "#E69F00",
    "#009E73",
    "#D55E00",
    "#56B4E9",
    "#CC79A7",
    "#F0E442",
    "#6B7280"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#0072B2",
  "good": "#009E73",
  "neutral": "#E69F00",
  "bad": "#D55E00",
  "maximum": "#D55E00",
  "center": "#F0E442",
  "minimum": "#FFF7BC",
  "firstLevelElements": "#1F2937",
  "secondLevelElements": "#475569",
  "thirdLevelElements": "#CBD5E1",
  "fourthLevelElements": "#E5E7EB",
  "secondaryBackground": "#F1F5F9",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#475569" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          { "show": true, "fontColor": { "solid": { "color": "#1F2937" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "alignment": "left" }
        ],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 4 }],
        "categoryAxis": [{ "gridlineShow": false }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E5E7EB" } } }],
        "legend": [{ "show": true, "position": "Bottom" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F8FAFC" } }, "transparency": 0 }]
      }
    }
  }
}
